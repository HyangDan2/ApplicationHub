{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "category",
          "tags",
          "thumbnail",
          "thumbnailAlt",
          "launchUrl",
          "status",
          "sortOrder",
          "updatedAt",
          "evidencePath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "Productivity",
              "Photo",
              "Learning",
              "Utility"
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "\\S"
            }
          },
          "thumbnail": {
            "type": "string",
            "pattern": "^assets/apps/[a-z0-9-]+\\.(jpg|jpeg|png|webp)$"
          },
          "thumbnailAlt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "\\S"
          },
          "launchUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "repositoryUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "maintenance"
            ]
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "imageKind": {
            "enum": [
              "screenshot",
              "artwork"
            ]
          },
          "evidencePath": {
            "type": "string",
            "pattern": "^docs/onboarding/[a-z0-9-]+\\.md$"
          }
        }
      }
    }
  }
}
